# Base44 sandbox development defaults — NOT secrets, NEVER production values.
#
# Listed FIRST under the api service's `env_file:` in docker-compose.base44.yml so
# that platform-delivered secrets in /run/base44/app.env — listed LAST — always win.
#
# To point this runtime at a hosted Neon branch, store the branch connection string
# (~/.neon or the Neon console "Connection string") as the DATABASE_URL app secret.
# It then overrides this offline fallback automatically.
DATABASE_URL=postgres://pact:pact-local-dev@db:5432/pact
