{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": ["packages/*/src", "packages/*/test", "services/*/src", "services/*/test", "apps/edge/src", "apps/edge/test", "supabase/functions/**/*.ts"]
}
